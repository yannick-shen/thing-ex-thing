<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <image class="loading-icon-img" src="/assets/icons/icon-contact-loading.png" />
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 主内容 -->
  <view wx:else class="content">
    <!-- 物品信息卡片 -->
    <view class="item-card">
      <view class="item-images" wx:if="{{item.images && item.images.length > 0}}">
        <image
          wx:for="{{item.images}}"
          wx:key="index"
          class="item-image"
          src="{{item}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-index="{{index}}"
        />
      </view>

      <view class="item-info">
        <view class="item-title">{{item.title}}</view>
        <view class="item-price">
          <text wx:if="{{item.mode === 'sale'}}">¥{{item.price}}</text>
          <text wx:if="{{item.mode === 'exchange'}}">交换</text>
          <text wx:if="{{item.mode === 'donate'}}">赠送</text>
        </view>
      </view>
    </view>

    <!-- 联系表单 -->
    <view class="form-card">
      <view class="form-title">联系 TA</view>
      <view class="form-tips">给卖家留言，说明您的需求</view>

      <textarea
        class="form-remark"
        value="{{remark}}"
        bindinput="onRemarkInput"
        placeholder="简单描述您的需求，如：想了解物品详情、约时间看货等..."
        maxlength="200"
        auto-height
        show-confirm-bar="{{false}}"
      />
      <view class="remark-count">{{remark.length}}/200</view>
    </view>

    <!-- 底部按钮 -->
    <view class="actions">
      <button class="btn-cancel" bindtap="cancel" hover-class="btn-hover">取消</button>
      <button class="btn-submit" bindtap="submitContactRequest" disabled="{{submitting}}" hover-class="btn-hover">
        {{submitting ? '发送中...' : '发送申请'}}
      </button>
    </view>
  </view>

  <!-- 积分不足弹窗 -->
  <view wx:if="{{showPointsModal}}" class="points-modal-mask" bindtap="closePointsModal">
    <view class="points-modal" catchtap="preventBubble">
      <view class="points-modal-title">积分不足</view>
      <view class="points-modal-body">
        <text>联系卖家需要 <text class="points-highlight">{{pointsModalData.cost}}</text> 积分</text>
        <text class="points-modal-sub">（每日前2次免费，超出后3积分/次）</text>
        <text class="points-modal-sub">当前余额：{{pointsModalData.balance}} 积分</text>
        <text class="points-modal-tip">观看广告可免费获取积分</text>
      </view>
      <view class="points-modal-actions">
        <view class="points-modal-btn cancel" bindtap="closePointsModal">取消</view>
        <view class="points-modal-btn confirm" bindtap="goWatchAd">前往看广告</view>
      </view>
    </view>
  </view>
</view>
