page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding: 16px;
  padding-bottom: 80px;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.loading-icon-img {
  width: 48px;
  height: 48px;
  margin-bottom: 16px;
}

.loading-text {
  font-size: 14px;
  color: #999;
}

/* 内容区域 */
.content {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 物品卡片 */
.item-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.item-images {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  margin-bottom: 12px;
  padding-bottom: 4px;
}

.item-image {
  width: 120px;
  height: 120px;
  border-radius: 8px;
  flex-shrink: 0;
  background: #f5f5f5;
}

.item-info {
  padding-top: 4px;
}

.item-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8px;
}

.item-price {
  font-size: 20px;
  font-weight: 600;
  color: #ff4d4f;
  margin-bottom: 8px;
}

.item-seller {
  display: flex;
  align-items: center;
  font-size: 14px;
  margin-bottom: 8px;
}

.seller-label {
  color: #999;
}

.seller-name {
  color: #333;
  font-weight: 500;
}

.item-meta {
  display: flex;
  gap: 16px;
  font-size: 12px;
  color: #999;
}

.meta-item {
  flex-shrink: 0;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.form-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 8px;
}

.form-tips {
  font-size: 13px;
  color: #999;
  margin-bottom: 12px;
}

.form-remark {
  width: 100%;
  min-height: 120px;
  padding: 12px;
  background: #f5f5f5;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1.5;
  color: #333;
  box-sizing: border-box;
}

.remark-count {
  text-align: right;
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

/* 底部按钮 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 8px 16px;
  display: flex;
  gap: 8px;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
}

.btn-cancel {
  flex: 1;
  background: #f5f5f5;
  color: #333;
  border-radius: 6px;
  font-size: 15px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-submit {
  flex: 2;
  background: #1677ff;
  color: #fff;
  border-radius: 6px;
  font-size: 15px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-submit[disabled] {
  background: #b8d4ff;
  color: rgba(255, 255, 255, 0.7);
}

.btn-hover {
  opacity: 0.7;
  transform: scale(0.98);
}

/* ============================================================
   积分不足弹窗
   ============================================================ */
.points-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.points-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 30rpx;
  box-sizing: border-box;
}

.points-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.points-modal-body {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.points-highlight {
  color: #ff4757;
  font-weight: 700;
  font-size: 32rpx;
}

.points-modal-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.points-modal-tip {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #ffa940;
}

.points-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.points-modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.points-modal-btn.cancel {
  background: #f5f5f5;
  color: #999;
}

.points-modal-btn.confirm {
  background: linear-gradient(135deg, #ffc53d, #ffa940);
  color: #fff;
}
