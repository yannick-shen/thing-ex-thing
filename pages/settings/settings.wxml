<view class="settings-container">
  <!-- 功能设置 -->
  <view class="setting-section">
    <view class="section-title">
      <image class="section-icon-img" src="/assets/icons/icon-mine-setting.png" />功能设置
    </view>

    <view class="setting-item" bindtap="goToContactSettings">
      <view class="setting-info">
        <view class="setting-label">联系方式</view>
      </view>
      <view class="setting-arrow">></view>
    </view>

    <!-- 消息通知暂时屏蔽 -->
    <!-- <view class="setting-item">
      <view class="setting-info">
        <view class="setting-label">消息通知</view>
      </view>
      <switch checked="{{notificationEnabled}}" bindchange="onNotificationChange" />
    </view> -->

    <view class="setting-item" bindtap="viewLocationSetting">
      <view class="setting-info">
        <view class="setting-label">位置权限</view>
      </view>
      <view class="setting-arrow">></view>
    </view>
  </view>

  <!-- 积分管理 -->
  <view class="setting-section">
    <view class="section-title">
      <image class="section-icon-img" src="/assets/icons/icon-mine-about.png" />积分管理
    </view>

    <view class="setting-item" bindtap="goToPointsDetail">
      <view class="setting-info">
        <view class="setting-label">积分明细</view>
        <view class="setting-desc">查看积分收入与支出记录</view>
      </view>
      <view class="setting-arrow">></view>
    </view>
  </view>

  <!-- 帮助与支持 -->
  <view class="setting-section">
    <view class="section-title">
      <image class="section-icon-img" src="/assets/icons/icon-mine-help.png" />帮助与支持
    </view>
    
    <view class="setting-item" bindtap="viewAgreement">
      <view class="setting-info">
        <view class="setting-label">用户协议</view>
      </view>
      <view class="setting-arrow">></view>
    </view>

    <view class="setting-item" bindtap="viewPolicy">
      <view class="setting-info">
        <view class="setting-label">隐私政策</view>
      </view>
      <view class="setting-arrow">></view>
    </view>

    <view class="setting-item" bindtap="viewRules">
      <view class="setting-info">
        <view class="setting-label">平台规则</view>
      </view>
      <view class="setting-arrow">></view>
    </view>

    <view class="setting-item" bindtap="contactService">
      <view class="setting-info">
        <view class="setting-label">联系我们</view>
      </view>
      <view class="setting-arrow">></view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="setting-section">
    <view class="section-title">
      <image class="section-icon-img" src="/assets/icons/icon-mine-about.png" />关于
    </view>
    
    <view class="setting-item">
      <view class="setting-info">
        <view class="setting-label-row">
          <text class="setting-label">版本号</text>
          <text class="setting-version">v1.0.4</text>
        </view>
      </view>
    </view>

    <view class="setting-item" bindtap="clearCache">
      <view class="setting-info">
        <view class="setting-label">清理缓存</view>
      </view>
      <view class="setting-arrow">></view>
    </view>
  </view>

  <!-- 重置功能 -->
  <view class="reset-section">
  
  <button class="btn-danger" bindtap="resetAgreement">
      重置用户协议
    </button>
  </view>

  <!-- 联系我们弹窗 -->
  <view wx:if="{{showContactModal}}" class="modal-overlay" bindtap="closeContactModal">
    <view class="modal-content" catchtap="preventBubble">
      <text class="modal-text">问题反馈，请发送邮件至邮箱\npy_young@163.com</text>
    </view>
  </view>
</view>