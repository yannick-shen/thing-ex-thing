.page-container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ============================================================
   账户摘要卡
   ============================================================ */
.balance-card {
  margin: 24rpx 30rpx;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  border-radius: 24rpx;
  color: #fff;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
}

.balance-header {
  font-size: 26rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}

.balance-num {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.balance-hint {
  font-size: 22rpx;
  opacity: 0.7;
  margin-bottom: 24rpx;
}

.balance-stats {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.75;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 700;
}

.stat-value.earn {
  color: #b7eb8f;
}

.stat-value.spend {
  color: #ffd591;
}

.stat-divider {
  width: 1rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* ============================================================
   明细列表区域
   ============================================================ */
.detail-section {
  margin: 0 30rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  padding: 28rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 加载中 / 空状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e8ecf1;
  border-top-color: #1677ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-img {
  width: 100rpx;
  height: 100rpx;
  opacity: 0.35;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #bbb;
}

/* 明细列表 */
.detail-list {
  padding: 0 30rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-left {
  flex: 1;
  min-width: 0;
}

.detail-type {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.detail-time {
  font-size: 22rpx;
  color: #aaa;
}

.detail-right {
  flex-shrink: 0;
  text-align: right;
  margin-left: 20rpx;
}

.detail-amount {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
}

.detail-amount.income {
  color: #52c41a;
}

.detail-amount.spend {
  color: #ff4d4f;
}

.detail-balance {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 2rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 28rpx;
  font-size: 26rpx;
  color: #1677ff;
  border-top: 1rpx solid #f5f5f5;
}

.load-end {
  text-align: center;
  padding: 28rpx;
  font-size: 24rpx;
  color: #ccc;
  border-top: 1rpx solid #f5f5f5;
}
