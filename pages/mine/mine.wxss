/* Tab 分段 */
.tab-section.fixed { position: sticky; top: 0; background: #f7f8fa; z-index: 1; padding: 12px 16px 8px; }
.tab-group { gap: 12px; }
.tab-item { position: relative; padding: 8px 16px; font-size: 14px; color: #666; }
.tab-item.active { color: #1677ff; font-weight: 600; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 20px; height: 3px; background: #1677ff; border-radius: 2px; }
.tab-text { position: relative; z-index: 1; }
.tab-count { position: absolute; top: 2px; right: 0; min-width: 16px; height: 16px; background: #ff4d4f; color: #fff; border-radius: 8px; font-size: 10px; display: flex; align-items: center; justify-content: center; padding: 0 4px; }

/* 列表容器 */
.items-list { padding: 8px 16px; }

/* 空状态 */
.empty-state { text-align: center; padding: 60px 20px; }
.empty-icon { font-size: 64px; margin-bottom: 12px; }
.empty-text { font-size: 16px; color: #333; margin-bottom: 8px; }
.empty-desc { font-size: 14px; color: #999; margin-bottom: 24px; }

/* 物品卡片 */
.card { margin-bottom: 12px; display: flex; }
.item-image { width: 90px; height: 90px; margin-right: 12px; flex-shrink: 0; }
.item-image image { width: 100%; height: 100%; border-radius: 8px; }
.item-content { flex: 1; min-width: 0; }
.item-desc { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-mode { font-size: 16px; font-weight: 600; }
.item-mode.mode-sale { color: #FF4757; }
.item-mode.mode-exchange { color: #3742FA; }
.item-mode.mode-donate { color: #2ED573; }
.item-mode.mode-help { color: #FFA502; }

/* 加载状态 */
.loading-state { text-align: center; padding: 40px 20px; }
.loading-icon { font-size: 24px; margin-bottom: 8px; }
.loading-icon-img { width: 24px; height: 24px; margin-bottom: 8px; }
.loading-text { font-size: 14px; color: #999; }

/* 内联小图标 */
.inline-icon-xs { width: 14px; height: 14px; vertical-align: middle; margin-right: 2px; }
.stat-item { display: flex; align-items: center; gap: 2px; }

/* 续期按钮 */
.btn-renew {
  background: #e6f7ff;
  color: #1677ff;
  border: 1rpx solid #91d5ff;
  border-radius: 6rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
}

/* 续期确认弹窗 */
.renew-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.renew-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 30rpx;
  box-sizing: border-box;
}

.renew-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.renew-modal-body {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.renew-item-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.renew-expire-compare {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.renew-expire-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.renew-expire-label {
  font-size: 22rpx;
  color: #999;
}

.renew-expire-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.renew-expire-value.new {
  color: #52c41a;
}

.renew-expire-value.old {
  color: #999;
}

.renew-arrow {
  font-size: 28rpx;
  color: #1677ff;
  font-weight: 700;
}

.renew-desc {
  display: block;
  font-size: 24rpx;
  color: #ffa940;
  margin-top: 8rpx;
}

.renew-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.renew-modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.renew-modal-btn.cancel {
  background: #f5f5f5;
  color: #999;
}

.renew-modal-btn.confirm {
  background: linear-gradient(135deg, #1677ff, #0958d9);
  color: #fff;
}
