<!-- 搜索胶囊 -->
<view class="search-capsule" catchtap="openSearch">
  <view class="capsule">
    <text class="capsule-text">搜索标题或描述</text>
  </view>
</view>

<!-- 视图切换 tabs -->
<view class="view-tabs">
  <view class="tab {{viewMode === 'map' ? 'active' : ''}}" bindtap="switchView" data-mode="map">📍 地图</view>
  <view class="tab {{viewMode === 'list' ? 'active' : ''}}" bindtap="switchView" data-mode="list">📋 列表</view>
</view>

<!-- ==================== 列表模式 ==================== -->
<view wx:if="{{viewMode === 'list'}}" class="list-container">
  <!-- 城市头部 -->
  <view class="list-city-header">
    <text class="list-city-name">{{listCity || '定位中...'}}</text>
    <text class="list-city-count">共 {{listItems.length}} 件物品</text>
  </view>

  <!-- 物品卡片列表 -->
  <scroll-view wx:if="{{listItems.length > 0}}" class="list-scroll" scroll-y="true" refresher-enabled="true" bindrefresherrefresh="onListRefresh" refresher-triggered="{{listRefreshing}}">
    <view
      wx:for="{{listItems}}"
      wx:key="id"
      class="list-card"
      bindtap="onListItemTap"
      data-id="{{item.id}}"
    >
      <image class="list-card-img" src="{{item.tempImage || '/assets/images/placeholder-item.png'}}" mode="aspectFill" />
      <view class="list-card-body">
        <text class="list-card-title">{{item.title}}</text>
        <text class="list-card-desc">{{item.desc || '暂无描述'}}</text>
        <view class="list-card-meta">
          <text wx:if="{{item.mode === 'sale'}}" class="list-card-price">¥{{item.price}}</text>
          <text wx:if="{{item.mode === 'exchange'}}" class="list-card-price mode-exchange">交换</text>
          <text wx:if="{{item.mode === 'donate'}}" class="list-card-price mode-donate">赠送</text>
          <text wx:if="{{item.mode === 'help'}}" class="list-card-price mode-help">求助</text>
          <text class="list-card-distance" wx:if="{{item.distanceText}}">{{item.distanceText}}</text>
        </view>
        <view class="list-card-footer">
          <text class="list-card-address" wx:if="{{item.addressText}}">📍 {{item.addressText}}</text>
          <text class="list-card-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="list-footer-hint">
      <text class="text-muted">— 已展示全部 {{listItems.length}} 条 —</text>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <view wx:if="{{listItems.length === 0 && !listLoading}}" class="list-empty">
    <text class="list-empty-icon">📦</text>
    <text class="text-muted">{{listCity ? listCity + '暂无物品' : '获取位置中...'}}</text>
    <text class="text-small text-muted">快去发布第一件物品吧</text>
    <button class="btn-primary list-empty-btn" bindtap="goPublish">发布物品</button>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{listLoading}}" class="list-loading">
    <text class="text-muted">加载中...</text>
  </view>
</view>

<!-- ==================== 地图模式（原有） ==================== -->
<!-- 聚合物品列表弹窗 -->
<view wx:if="{{viewMode === 'map' && showClusterList}}" class="overlay cluster-overlay" catchtouchmove="prevent">
  <view class="card cluster-panel" catchtap="prevent">
    <view class="flex-between">
      <text class="text-title">附近物品</text>
      <text class="text-muted" bindtap="hideClusterList">×</text>
    </view>
    <scroll-view class="cluster-list" scroll-y="true">
      <view
        wx:for="{{clusterItems}}"
        wx:key="id"
        class="card-item"
        bindtap="selectClusterItem"
        data-id="{{item.id}}"
      >
        <image class="cluster-item-img" src="{{item.tempImage || (item.images && item.images.length > 0 ? item.images[0] : '/assets/images/placeholder-item.png')}}" mode="aspectFill" />
        <view class="cluster-item-info flex-column gap-sm">
          <text class="text-title">{{item.title}}</text>
          <view class="cluster-item-price mode-{{item.mode}}">
            <text wx:if="{{item.mode === 'sale'}}">¥{{item.price}}</text>
            <text wx:if="{{item.mode === 'exchange'}}">交换</text>
            <text wx:if="{{item.mode === 'donate'}}">赠送</text>
            <text wx:if="{{item.mode === 'help'}}">求助</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<view wx:if="{{viewMode === 'map' && searchKeyword}}" class="filter-tag" catchtap="clearSearch">已筛选:{{searchKeyword}}</view>

<!-- 地图 -->
<map wx:if="{{viewMode === 'map'}}" id="map" longitude="{{center.longitude}}" latitude="{{center.latitude}}" scale="{{scale}}" style="width: 100%; height: 100vh;" show-location="{{showLocation}}" enable-scroll="true" enable-zoom="true" bindregionchange="onRegionChange" bindmarkertap="onMarkerTap" markers="{{markers}}">
</map>

<!-- 定位提示气泡 -->
<view wx:if="{{viewMode === 'map' && showLocationTip}}" class="location-tip" catchtap="relocate">
  <view class="location-tip-content">
    <text class="location-tip-text">点我查看您身边的闲置物品</text>
    <view class="location-tip-close" catchtap="dismissLocationTip">×</view>
  </view>
  <view class="location-tip-arrow"></view>
</view>

<!-- 按钮组 -->
<view wx:if="{{viewMode === 'map'}}" class="button-group">
  <view class="fab location" bindtap="relocate">
    <image class="button-icon" src="/assets/icons/locate.png" />
  </view>
</view>

<!-- 物品详情弹窗 -->
<view wx:if="{{showDetailModal}}" class="detail-modal"
      catchtap="hideDetailModal">
  <view class="card detail-panel" catchtap="stopPropagation">
    <!-- 图片轮播 -->
    <view class="detail-swiper" wx:if="{{detailItem && detailItem.images.length > 0}}">
      <!-- 关闭按钮浮在图片上方 -->
      <text class="text-muted detail-close-btn" bindtap="hideDetailModal" style="position: absolute; top: 8px; right: 8px; z-index: 10; background: transparent; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">×</text>
      <swiper class="detail-img-swiper" indicator-dots="true" bindchange="onDetailSwiperChange">
        <swiper-item wx:for="{{detailItem.images}}" wx:key="index" wx:for-item="img">
          <image src="{{img}}" mode="aspectFill" class="detail-swiper-img" bindtap="previewDetailImage" data-index="{{index}}" />
        </swiper-item>
      </swiper>
      <view class="detail-img-indicator">{{detailImgIndex + 1}}/{{detailItem.images.length}}</view>
    </view>

    <!-- 物品信息 -->
    <scroll-view class="detail-content" scroll-y="true">
      <text class="text-title">{{detailItem.title}}</text>

      <view class="flex-between">
        <view class="flex-row gap-md">
          <text wx:if="{{detailItem.mode === 'sale'}}" class="text-title">¥{{detailItem.price}}</text>
          <text wx:if="{{detailItem.mode === 'exchange'}}" class="text-title">交换</text>
          <text wx:if="{{detailItem.mode === 'donate'}}" class="text-title">赠送</text>
          <text wx:if="{{detailItem.mode === 'help'}}" class="text-title">求助</text>
        </view>
        <view class="flex-row gap-md">
          <text class="text-small">{{detailItem.counters.views}} 浏览</text>
          <text class="text-small">{{detailItem.counters.favorites}} 收藏</text>
        </view>
      </view>

      <text class="text-body">{{detailItem.desc}}</text>

      <view class="detail-time">
        <text class="text-muted">发布时间: {{detailCreateTime}}</text>
      </view>

      <!-- 位置信息 -->
      <view class="detail-location">
        <view class="location-label"><image class="inline-icon" src="/assets/icons/icon-main-location.png" /><text class="text-small">交易位置</text></view>
        <map class="detail-location-map"
             latitude="{{detailItem.lat}}"
             longitude="{{detailItem.lng}}"
             scale="16"
             show-location="false"
             enable-scroll="false"
             enable-zoom="true"
             markers="{{[{id:0, latitude:detailItem.lat, longitude:detailItem.lng, width:24, height:24}]}}">
        </map>
        <text class="text-body">{{detailItem.addressText || '当前位置'}}</text>
      </view>
    </scroll-view>

    <!-- 评论入口 -->
    <view class="card-item" bindtap="goToComments" wx:if="{{detailItem}}">
      <view class="flex-row gap-sm">
        <image class="inline-icon-sm" src="/assets/icons/icon-main-message.png" />
        <text class="text-body">{{detailItem.commentCount || 0}} 条留言</text>
        <text class="text-muted">></text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="flex-row gap-md detail-actions">
      <button class="btn-primary {{detailFavorited ? '' : ''}}" bindtap="handleDetailFavorite">
        {{detailFavorited ? '已收藏' : '收藏'}}
      </button>
      <button class="btn-secondary" bindtap="handleDetailContact">联系 TA</button>
    </view>
  </view>
</view>

<!-- 搜索面板 -->
<view wx:if="{{showSearch}}" class="overlay" catchtouchmove="prevent">
  <view class="card search-panel">
    <input class="input" placeholder="请输入关键词" value="{{tmpKeyword}}" bindinput="onInput" confirm-type="search" bindconfirm="applySearch" />

    <view class="mode-section">
      <text class="text-title">类型</text>
      <view class="mode-options">
        <view
          wx:for="{{modeOptions}}"
          wx:key="value"
          class="mode-option {{selectedMode === item.value ? 'active' : ''}}"
          bindtap="selectMode"
          data-mode="{{item.value}}"
        >
          {{item.label}}
        </view>
      </view>
    </view>

      <view wx:if="{{searchHistory.length > 0}}" class="history-section">
      <view class="flex-between">
        <text class="text-title">搜索历史</text>
        <text class="text-muted" bindtap="clearHistory">清空</text>
      </view>
      <view class="history-tags">
        <view wx:for="{{searchHistory}}" wx:key="index" class="history-tag" bindtap="selectHistory" data-keyword="{{item}}">
          {{item}}
        </view>
      </view>
    </view>

    <view class="search-actions flex-row gap-md">
      <button class="btn-secondary" bindtap="closeSearch">取消</button>
      <button class="btn-primary" bindtap="applySearch">搜索</button>
    </view>
  </view>
</view>



