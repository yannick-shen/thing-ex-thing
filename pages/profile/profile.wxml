<view class="profile-container">
  <!-- 顶部个人信息 -->
  <view class="header">
    <!-- 未登录状态 -->
    <view wx:if="{{!isLoggedIn}}" class="login-prompt">
      <image class="login-icon-img" src="/assets/icons/icon-mine-unloggin.png" />
      <view class="login-title">登录后可享受完整功能</view>
      <button class="login-btn btn-primary" bindtap="goToLogin">立即登录</button>
    </view>

    <!-- 已登录状态 -->
    <view wx:else class="user-info">
      <view class="avatar" bindtap="changeAvatar">
        <image wx:if="{{userInfo.profile.avatarUrl}}"
               src="{{userInfo.profile.avatarUrl}}"
               class="avatar-image"
               mode="aspectFill" />
        <image wx:else class="avatar-placeholder-img" src="/assets/icons/icon-mine-unloggin.png" />
      </view>
      <view class="user-details">
        <view class="username" bindtap="editNickname">{{userInfo.profile.nickname || '用户'}}<image class="edit-icon-img" src="/assets/icons/icon-mine-edit.png" /></view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <!-- 我的物品 -->
    <view class="menu-group">
      <view class="menu-item" bindtap="goToMyItems">
        <image class="menu-icon-img" src="/assets/icons/icon-mine-mything.png" />
        <view class="menu-info">
          <view class="menu-title">我的物品</view>
        </view>
        <view class="menu-badge" wx:if="{{stats.active > 0}}">{{stats.active}}</view>
        <view class="menu-arrow">></view>
      </view>

      <view class="menu-item" bindtap="goToFavorites">
        <image class="menu-icon-img" src="/assets/icons/icon-mine-favorite.png" />
        <view class="menu-info">
          <view class="menu-title">我的收藏</view>
        </view>
        <view class="menu-badge" wx:if="{{stats.favorited > 0}}">{{stats.favorited}}</view>
        <view class="menu-arrow">></view>
      </view>
    </view>

    <!-- 设置功能 -->
    <view class="menu-group">
      <view class="menu-item" bindtap="goToSettings">
        <image class="menu-icon-img" src="/assets/icons/icon-mine-setting.png" />
        <view class="menu-info">
          <view class="menu-title">应用设置</view>
        </view>
        <view class="menu-arrow">></view>
      </view>

      <view class="menu-item" bindtap="contactService">
        <image class="menu-icon-img" src="/assets/icons/icon-mine-contruct.png" />
        <view class="menu-info">
          <view class="menu-title">联系我们</view>
        </view>
        <view class="menu-arrow">></view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="menu-group">
      <view class="menu-item" bindtap="goToAbout">
        <image class="menu-icon-img" src="/assets/icons/icon-mine-about.png" />
        <view class="menu-info">
          <view class="menu-title">关于我们</view>
        </view>
        <view class="menu-arrow">></view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="menu-group" wx:if="{{isLoggedIn}}">
      <view class="menu-item logout-item" bindtap="logout">
        <image class="menu-icon-img" src="/assets/icons/icon-mine-exit.png" />
        <view class="menu-info">
          <view class="menu-title logout-title">退出登录</view>
        </view>
        <view class="menu-arrow">></view>
      </view>
    </view>
  </view>

  <!-- 联系我们弹窗 -->
  <view wx:if="{{showContactModal}}" class="modal-overlay" bindtap="closeContactModal">
    <view class="modal-content" catchtap="preventBubble">
      <text class="modal-text">问题反馈，请发送邮件至邮箱\npy_young@163.com</text>
    </view>
  </view>

</view>