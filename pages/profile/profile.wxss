.profile-container {
  min-height: 94vh;
  background: white;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

/* 顶部个人信息 */
.header {
  background: white;
  padding: 10rpx 30rpx 0rpx;
  color: white;
}

/* 登录提示 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 60rpx;
  padding-bottom: 30rpx;
}

.login-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.login-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.login-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 60rpx;
}

.login-btn {
  background: #1677ff;
  color: white;
  border: none;
  border-radius: 8px;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin-right: 30rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 60rpx;
}

.avatar-placeholder-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: 20rpx;
  padding: 6rpx 0;
  text-align: center;
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
}

.user-details {
  flex: 1;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.edit-icon {
  font-size: 20rpx;
  margin-left: 20rpx;
}

.edit-icon-img {
  width: 20rpx;
  height: 20rpx;
  margin-left: 20rpx;
  vertical-align: middle;
}

/* ============================================================
   签到卡片
   ============================================================ */
.signin-card {
  margin: 16rpx 30rpx;
  background: linear-gradient(135deg, #e8f4ff 0%, #f0f7ff 100%);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #d6e8ff;
}

.signin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.signin-title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.signin-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1677ff;
}

.signin-streak {
  font-size: 24rpx;
  color: #999;
}

/* 7 天指示器 */
.signin-days {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.signin-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
  border-radius: 10rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  position: relative;
  transition: all 0.2s;
}

.signin-day.done {
  background: #1677ff;
  border-color: #1677ff;
}

.signin-day.today {
  border-color: #1677ff;
  background: #fff;
  box-shadow: 0 0 0 2rpx rgba(22, 119, 255, 0.2);
}

.day-check {
  font-size: 28rpx;
  color: #fff;
  line-height: 1;
}

.signin-day.today .day-check {
  color: #1677ff;
}

.day-num {
  font-size: 26rpx;
  color: #bbb;
  line-height: 1;
}

.day-reward {
  font-size: 18rpx;
  color: #999;
  margin-top: 6rpx;
}

.signin-day.done .day-reward {
  color: rgba(255,255,255,0.8);
}

.signin-day.today .day-reward {
  color: #1677ff;
  font-weight: 600;
}

/* 签到按钮 */
.signin-action {
  display: flex;
  justify-content: center;
}

.signin-btn {
  width: 100%;
  text-align: center;
  padding: 16rpx 0;
  background: #1677ff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.signin-btn:active {
  background: #0958d9;
}

.signin-done-btn {
  width: 100%;
  text-align: center;
  padding: 16rpx 0;
  background: #e8e8e8;
  color: #bbb;
  font-size: 28rpx;
  border-radius: 12rpx;
}

/* ============================================================
   广告奖励卡片
   ============================================================ */
.ad-card {
  margin: 0 30rpx 16rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #fffbe6 100%);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #ffe58f;
}

.ad-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ad-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ad-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #d48806;
}

.ad-mock-tag {
  font-size: 20rpx;
  color: #fa8c16;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
}

.ad-progress {
  font-size: 24rpx;
  color: #999;
}

/* 阶梯指示 */
.ad-tiers {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.ad-tier {
  flex: 1;
  text-align: center;
  padding: 12rpx 4rpx;
  border-radius: 10rpx;
  background: #fff;
  border: 2rpx solid #f0f0f0;
  transition: all 0.2s;
}

.ad-tier.active {
  border-color: #d48806;
  background: #fffbe6;
  box-shadow: 0 0 0 2rpx rgba(212, 136, 6, 0.15);
}

.ad-tier-num {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.ad-tier.active .ad-tier-num {
  color: #d48806;
}

.ad-tier-range {
  display: block;
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.ad-tier.active .ad-tier-range {
  color: #d48806;
}

/* 观看按钮 */
.ad-action {
  display: flex;
  justify-content: center;
}

.ad-btn {
  width: 100%;
  text-align: center;
  padding: 16rpx 0;
  background: linear-gradient(135deg, #ffc53d, #ffa940);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  line-height: 1.4;
}

.ad-btn::after {
  border: none;
}

.ad-btn[disabled] {
  background: #e8e8e8;
  color: #bbb;
}

.ad-done-btn {
  width: 100%;
  text-align: center;
  padding: 16rpx 0;
  background: #e8e8e8;
  color: #bbb;
  font-size: 28rpx;
  border-radius: 12rpx;
}

/* 功能菜单 */
.menu-section {
  padding: 10rpx 30rpx 10rpx;
}

.menu-group {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 25rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.menu-icon-img {
  width: 80rpx;
  height: 80rpx;
  margin-right: 25rpx;
}

.menu-info {
  flex: 1;
}

.menu-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 5rpx;
}

.menu-desc {
  font-size: 26rpx;
  color: #666;
}

.menu-badge {
  background: #ff4757;
  color: white;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 30rpx;
  text-align: center;
  margin-right: 15rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 退出登录按钮 */
.logout-item {
  background: #fff5f5;
  border-bottom: 1rpx solid #ffedeb;
}

.logout-item:active {
  background: #ffe8e6;
}

.logout-title {
  color: #ff4d4f;
  font-weight: bold;
}

.logout-desc {
  color: #ff7875;
  font-size: 24rpx;
}

/* 联系我们弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 50rpx 40rpx;
  margin: 0 60rpx;
  text-align: center;
}

.modal-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-line;
}

